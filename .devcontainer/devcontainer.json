{
  "name": "basic-memory-dev",
  "dockerComposeFile": [
    "../docker-compose.yml",
    "../docker-compose.override.yml"
  ],
  "service": "dev",
  "workspaceFolder": "/workspace",
  "runServices": [
    "dev",
    "basic-memory",
    "syncthing",
    "todo-agent",
    "gateway"
  ],
  "initializeCommand": "sh scripts/init-local-volumes.sh",
  "postCreateCommand": "sudo apt-get update && sudo apt-get install -y --no-install-recommends jq",
  "remoteUser": "vscode",
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "yzhang.markdown-all-in-one",
        "github.vscode-github-actions"
      ]
    }
  }
}